# ── AI Router Configuration ──────────────────────────────────────────
# Both keys are optional. The router uses whichever are provided.
# If both are set, they work in round-robin with instant failover.

# Existing AnyRouter key (free tier)
ANYROUTER_API_KEY=

# OpenRouter key — supports many models (Gemini, Llama, DeepSeek, Qwen)
OPENROUTER_API_KEY=

# ── Monitor alert delivery (optional) ────────────────────────────────
# HTTPS webhook that receives queue- and runtime-monitor transition events.
ALERT_WEBHOOK_URL=
# At least 32 characters; signs requests with HMAC-SHA256 when set.
ALERT_WEBHOOK_SECRET=

# ── Runtime alert monitor (optional, scripts/runtime-monitor.js) ─────
RUNTIME_MONITOR_URL=
RUNTIME_ALERT_ERROR_RATE=
RUNTIME_ALERT_ANSWER_P95_MS=
# Dedicated SQLite file that remembers delivered alert state across monitor restarts.
ALERT_STATE_PATH=

# ── Server and queue paths ──────────────────────────────────────────
# Admin bearer token (random, at least 24 characters). Admin is disabled when unset.
ADMIN_TOKEN=
# Existing job queue database, used by the worker and queue monitor.
JOB_DB_PATH=

# ── SaaS plans (optional; see docs/SAAS_PLANS.md) ────────────────────
# Dedicated SQLite file for accounts, hashed API keys and monthly usage. Enables plans.
ACCOUNTS_DB_PATH=
# 64 hex characters; keeps anonymous Free-plan metering stable across restarts.
ACCOUNTS_SECRET=
# Account email (SaaS mode): console (development; prints links to the log) or resend.
EMAIL_PROVIDER=
# Sender, for example: Northstar <no-reply@yourdomain.com>  (required for resend)
EMAIL_FROM=
RESEND_API_KEY=
# Public site address used in emailed links, for example https://app.example.com
PUBLIC_ORIGIN=

# ── Testing mode (never in production) ───────────────────────────────
# TEST_MODE=1 creates a public demo administrator, auto-logs visitors in and shows the
# login on screen. The server refuses to start with it when NODE_ENV=production.
# `npm run start:test` sets all of this for you with separate test databases.
TEST_MODE=
TEST_MODE_EMAIL=
TEST_MODE_PASSWORD=
